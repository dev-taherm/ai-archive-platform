{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basirah Desktop",
  "version": "0.1.0",
  "identifier": "com.basirah.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "mkdir -p src-tauri/target/debug && ln -sf ../../binaries/edge-agent-x86_64-unknown-linux-gnu src-tauri/target/debug/edge-agent && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Basirah Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://.*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/edge-agent"]
  }
}
