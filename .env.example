# =============================================================================
# AI Archive Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# =============================================================================
# Django Core
# =============================================================================

# Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (set to false in production)
DJANGO_DEBUG=false

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL prefix for admin
DJANGO_ADMIN_URL=admin/

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://ai_archive_user:your-password@postgres:5432/ai_archive

# Individual PostgreSQL variables (used by docker-compose)
POSTGRES_DB=ai_archive
POSTGRES_USER=ai_archive_user
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_PORT=5432

# =============================================================================
# Redis
# =============================================================================

# Redis connection URL (used for caching)
REDIS_URL=redis://redis:6379/0

# Redis port (for local development)
REDIS_PORT=6379

# =============================================================================
# Celery
# =============================================================================

# Celery broker URL
CELERY_BROKER_URL=redis://redis:6379/1

# Celery result backend URL
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Number of concurrent worker processes
CELERY_CONCURRENCY=4

# =============================================================================
# AI / LLM Services
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI organization ID (optional)
OPENAI_ORG_ID=

# Google Gemini API key
GOOGLE_API_KEY=your-google-api-key

# Ollama base URL (for local LLM deployment)
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM provider: openai | google | ollama
DEFAULT_LLM_PROVIDER=openai

# Default LLM model
DEFAULT_LLM_MODEL=gpt-4o

# =============================================================================
# Vector Search
# =============================================================================

# pgvector dimension for embeddings
EMBEDDING_DIMENSION=384

# Embedding model (local multilingual model, no API key needed)
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2

# =============================================================================
# Document Processing
# =============================================================================

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=100

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg,tiff

# Tesseract OCR language
TESSEROCR_LANGUAGE=eng

# =============================================================================
# Storage
# =============================================================================

# Media files path
MEDIA_ROOT=/app/media

# Static files path
STATIC_ROOT=/app/staticfiles

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Security
# =============================================================================

# JWT access token lifetime in minutes
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# JWT refresh token lifetime in days
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# Monitoring (Production)
# =============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Sentry environment label
SENTRY_ENVIRONMENT=production

# Sentry sample rate for performance monitoring (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Frontend
# =============================================================================

# Backend API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket URL (used by Next.js)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Frontend port
FRONTEND_PORT=3000

# =============================================================================
# Docker
# =============================================================================

# Web server port
WEB_PORT=8000
